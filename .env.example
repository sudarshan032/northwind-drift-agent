# Copy to .env for the live agent. Without a provider, detection, radius, change review and the UI still work.
# LLM_PROVIDER: openai (default) | openrouter (free models) | anthropic | fake (scripted, no network). Unset: openai
# if OPENAI_API_KEYS is set, else openrouter if OPENROUTER_API_KEY is set, else anthropic, else no LLM.
LLM_PROVIDER=
# One or more OpenAI keys, comma-separated, tried in this order (bad key / no credit / rate limit -> next key).
OPENAI_API_KEYS=
AGENT_MODEL=gpt-6-luna
# One daily dollar cap for every model call (agent, explanations, chat), all keys together.
AGENT_DAILY_USD=1.00
OPENROUTER_API_KEY=
# Preference list; only free (:free, zero price) tool-capable models are kept, the rest are OpenRouter fallbacks.
NORTHWIND_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,thinkingmachines/inkling:free
# Daily request budget (free tier: 50 without purchased credits, 1000 with at least 10 credits).
NORTHWIND_DAILY_REQUESTS=50
ANTHROPIC_API_KEY=
NORTHWIND_MODEL=claude-sonnet-5-5

# Public deployment (Vercel + FalkorDB Cloud): set these in the Vercel project, never in a committed file.
# DEPLOY_MODE=public
# FALKORDB_HOST=
# FALKORDB_PORT=
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_TLS=false        # FalkorDB Cloud free tier has no TLS; true for Startup and above
# NORTHWIND_DATA=data_demo  # sources.json for the Sources tab
# CRON_SECRET=              # random string; Vercel cron sends it to /cron/reset
